<?xml version="1.0"?>
<robot name="yattara_amr">

  <!-- Main robot body reference frame -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.40 0.20"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <box size="0.50 0.40 0.20"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <mass value="20.0"/>
      <inertia ixx="0.35" ixy="0.0" ixz="0.0"
               iyy="0.45" iyz="0.0"
               izz="0.55"/>
    </inertial>
  </link>

  <!-- RPLIDAR C1 frame -->
  <link name="laser">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
      </material>
    </visual>
  </link>

  <!-- Fixed transform from robot body to RPLIDAR C1 -->
    <joint name="base_link_to_laser" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.115 0.095 0.050" rpy="0.0 0.0 0.7854"/>
    </joint>

</robot>