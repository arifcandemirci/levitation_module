
<sdf version='1.7'>
  <world name='levitation_world'>
    <light name='sun' type='directional'>
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>

    <physics type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <model name='copper_plate'>
      <static>true</static>
      <pose>-0.510715 0.350583 2.0 0 0 0</pose>
      <link name='plate_link'>
        <!--
          Non-overlapping top-view layout:
          - main plates are 0.9 x 3.6 and run along Y
          - connector_left_center spans X [-2.85, -0.45]
          - connector_center_right spans X [0.45, 2.25]
          - connector faces touch the main plate faces without penetrating
        -->
        <collision name='main_plate_left'>
          <pose>-3.3 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.9 3.6 0.0015</size>
            </box>
          </geometry>
        </collision>
        <visual name='main_plate_left'>
          <pose>-3.3 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.9 3.6 0.0015</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Yellow</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
    <visual name='test_apriltag_0'>
	  <!-- Copper plate alt yüzeyinin biraz altına koyuyoruz -->
	  <pose>0 0 -0.01 3.14159 0 0</pose>

	  <geometry>
	    <plane>
	      <normal>0 0 1</normal>
	      <size>0.007 0.007</size>
	    </plane>
	  </geometry>

	  <material>
	    <script>
	      <uri>file://media/materials/scripts/apriltag.material</uri>
	      <uri>file://media/materials/textures</uri>
	      <name>AprilTag/Test0</name>
	    </script>
	  </material>
	</visual>
        <collision name='main_plate_center'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.9 3.6 0.0015</size>
            </box>
          </geometry>
        </collision>
        <visual name='main_plate_center'>
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.9 3.6 0.0015</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Yellow</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <collision name='main_plate_right'>
          <pose>2.7 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.9 3.6 0.0015</size>
            </box>
          </geometry>
        </collision>
        <visual name='main_plate_right'>
          <pose>2.7 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>0.9 3.6 0.0015</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Yellow</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <collision name='connector_left_center'>
          <pose>-1.65 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>2.4 0.9 0.0015</size>
            </box>
          </geometry>
        </collision>
        <visual name='connector_left_center'>
          <pose>-1.65 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>2.4 0.9 0.0015</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Yellow</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
        <collision name='connector_center_right'>
          <pose>1.35 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 0.9 0.0015</size>
            </box>
          </geometry>
        </collision>
        <visual name='connector_center_right'>
          <pose>1.35 0 0 0 0 0</pose>
          <geometry>
            <box>
              <size>1.8 0.9 0.0015</size>
            </box>
          </geometry>
          <material>
            <script>
              <name>Gazebo/Yellow</name>
              <uri>file://media/materials/scripts/gazebo.material</uri>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>1.45 8.80 13.90 0 0.792 -1.6508</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>
  </world>
</sdf>
